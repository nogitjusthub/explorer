[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

vis_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
weather_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
weather_radius={
"type": "float",
"value": 0.0
}
weather_clear={
"type": "float",
"value": 4.0
}
weather_gas_y={
"type": "float",
"value": -1000.0
}
weather_max={
"type": "float",
"value": 0.9
}
weather_gloom={
"type": "float",
"value": 0.0
}
vis_color={
"type": "color",
"value": Color(0.55, 0.6, 0.7, 1)
}
storm_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
storm_radius={
"type": "float",
"value": 0.0
}
storm_dark={
"type": "float",
"value": 0.5
}
