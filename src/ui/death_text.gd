class_name DeathText
extends RefCounted
## Надписи о конце забега (GDD §2.5): заголовок экрана итога по причине и баннер в момент гибели. Три набора —
## выбор не окончательный, поэтому хранятся все: VEHICLE — о машине (женский род), MALE — мужской род, JOKE —
## шутливо, средний род («оно», железка). Какой показывается — STYLE.

enum Style { VEHICLE, MALE, JOKE }

const STYLE := Style.JOKE

