## Баннер в момент гибели (HUD): машина разбита / ушла под воду в водовороте.
const BANNERS := {
	Style.VEHICLE: {&"wrecked": "МАШИНА РАЗБИТА", &"sunk": "МАШИНА УТОНУЛА"},
	Style.MALE: {&"wrecked": "РАЗБИТ", &"sunk": "УТОНУЛ"},
	Style.JOKE: {&"wrecked": "РАЗВАЛИЛОСЬ", &"sunk": "БУЛЬКНУЛО"},
}


## Заголовок итога по причине конца (неизвестная — «прочее»); style — для тестов и сравнения.
static func cause(id: String, style: Style = STYLE) -> String:
	var texts: Dictionary = CAUSES[style]
	return texts.get(id, texts[""])


static func banner(kind: StringName, style: Style = STYLE) -> String:
	return BANNERS[style][kind]
